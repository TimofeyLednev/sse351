REGEDIT4

; ntver.sys - NT 4.0 DDK driver load test for Windows NT 3.51
;
; IMPORTANT: NT 3.51 ships REGEDT32 only. It has no REGEDIT and cannot import
; a REGEDIT4 text file - it can only restore a binary hive (.regedt32). So this
; file is NOT directly importable on 3.51. Use it on a modern machine to
; inspect the values, or set them by hand in REGEDT32 (see README.md). On
; Windows 2000+ you can merge this file normally.
;
; Copy ntver.sys to \SystemRoot\system32\drivers\ first (usually
; C:\WINNT35\SYSTEM32\DRIVERS on 3.51).
;
; Start=3 is DEMAND_START: load it now, no reboot. A failure cannot affect
; the next boot.
;
;     net start ntver        - load it
;     net stop  ntver        - unload it
;
; "The ntver service was started successfully" means the NT 4.0 DDK binary
; loaded on 3.51 and DriverEntry returned STATUS_SUCCESS - the entire point of
; this driver. Set Start to dword:00000004 to disable.

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\ntver]
"Type"=dword:00000001
"Start"=dword:00000003
"ErrorControl"=dword:00000001
"Group"="Base"
"Tag"=dword:00000001
"ImagePath"=hex(2):
5c,00,53,00,79,00,73,00,74,00,65,00,6d,00,52,00,6f,00,6f,00,74,00,5c,00,\
  73,00,79,00,73,00,74,00,65,00,6d,00,33,00,32,00,5c,00,64,00,72,00,69,00,\
  76,00,65,00,72,00,73,00,5c,00,6e,00,74,00,76,00,65,00,72,00,2e,00,73,00,\
  79,00,73,00,00,00
